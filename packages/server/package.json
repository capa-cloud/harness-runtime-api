{
  "name": "@harness-runtime/server",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP and SSE binding for Harness Runtime API.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "harness-runtime-server": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@harness-runtime/core": "workspace:*",
    "@harness-runtime/protocol": "workspace:*",
    "@harness-runtime/provider-mock": "workspace:*",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.5"
  },
  "devDependencies": {
    "tsx": "4.23.12"
  }
}
